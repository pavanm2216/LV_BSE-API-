# Copy to .env and fill in your real values. Never commit the real .env.

STARMF_PROTOCOL=https
STARMF_BASE_URL=your-starmf-host.example.com

# Only used by the reference /login flow if you build a convenience wrapper;
# the /login endpoint itself takes username/password in the request body.
STARMF_LOGIN_USERNAME=member/0000/abcd.admin
STARMF_LOGIN_PASSWORD=change-me

# --- Encryption (application/jose) -----------------------------------------
# Leave false unless you have confirmed BSE's exact JOSE profile with them.
STARMF_USE_ENCRYPTION=false
STARMF_API_ORG_ID=member/0000:your-api-key

STARMF_MEMBER_PRIVATE_KEY_PATH=./keys/member_private.pem
STARMF_BSE_PUBLIC_KEY_PATH=./keys/bse_public.pem
STARMF_MEMBER_PRIVATE_KEY_FOR_DECRYPT_PATH=./keys/member_private.pem
STARMF_BSE_PUBLIC_KEY_FOR_VERIFY_PATH=./keys/bse_public.pem

STARMF_HTTP_TIMEOUT_SECONDS=30
STARMF_VERIFY_TLS=true
